{
  "schema": "zizpanel.app/v1",
  "id": "alist",
  "name": "Alist（文件列表）",
  "icon": "📂",
  "summary": "把网盘、对象存储、本地目录挂成一个网页文件站",
  "notes": [
    "上游只有 md5 清单、没有 sha256：这条轨只做架构复核 + md5 互证，不假装校验过 sha256。",
    "首次打开后用面板给的初始口令登录（安装结果里有），登录后请自行改掉。"
  ],
  "source": {
    "kind": "release",
    "repo": "AlistGo/alist",
    "tag": "v3.64.0",
    "asset": "alist-darwin-arm64.tar.gz",
    "binary": "alist",
    "targz": true,
    "pick_one": true,
    "checksum": "md5"
  },
  "run": {
    "mode": "app-daemon",
    "bin": "~/alist/alist",
    "args": [
      "server",
      "--data",
      "~/alist/data"
    ]
  },
  "config": {
    "path": "~/alist/data/config.json",
    "mode": "0600",
    "own": "user"
  },
  "expose": {
    "port": 5244,
    "bind": "0.0.0.0",
    "ui": "app",
    "path": "/"
  },
  "verify": {
    "any_of": [
      {
        "kind": "http",
        "path": "/",
        "expect": "",
        "timeout": "60s"
      },
      {
        "kind": "process",
        "label": "com.zizdog.alist"
      }
    ]
  },
  "health": {
    "kind": "http",
    "path": "/",
    "interval": "30s"
  },
  "uninstall": {
    "always": [
      "/Library/LaunchDaemons/com.zizdog.alist.plist"
    ],
    "optional_data": [
      "~/alist"
    ],
    "keep_note": "~/alist 里还有 data/（账号与存储配置）：勾选「删除数据」才会删。"
  },
  "update": {
    "kind": "release-index"
  },
  "requires": {
    "ports": [
      5244
    ]
  }
}