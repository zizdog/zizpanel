{
  "schema": "zizpanel.app/v1",
  "id": "syncthing",
  "name": "Syncthing（文件同步）",
  "icon": "🔄",
  "summary": "去中心化文件同步（不经过云盘）",
  "notes": [
    "面板安装时会同时做两件事：把 GUI 监听到 0.0.0.0:8384、并设置随机登录口令 —— 只做前者等于把同步界面裸奔在局域网。",
    "局域网内同步需要 macOS 的「本地网络」权限（系统设置 → 隐私与安全性 → 本地网络）。"
  ],
  "source": {
    "kind": "brew",
    "formula": "syncthing",
    "checksum": "sha256"
  },
  "run": {
    "mode": "brew-service",
    "hooks": [
      "syncthing-gui-lan"
    ]
  },
  "config": {
    "path": "~/Library/Application Support/Syncthing/config.xml",
    "mode": "0600",
    "own": "user",
    "secrets": [
      "gui-user",
      "gui-password"
    ]
  },
  "expose": {
    "port": 8384,
    "bind": "0.0.0.0",
    "ui": "app",
    "path": "/"
  },
  "verify": {
    "any_of": [
      {
        "kind": "http",
        "path": "/rest/noauth/health",
        "expect": "ok",
        "timeout": "60s"
      }
    ]
  },
  "health": {
    "kind": "http",
    "path": "/rest/noauth/health",
    "expect": "ok",
    "interval": "30s"
  },
  "uninstall": {
    "always": [
      "/Library/LaunchDaemons/homebrew.mxcl.syncthing.plist"
    ],
    "optional_data": [
      "~/Library/Application Support/Syncthing"
    ],
    "formula": "syncthing",
    "keep_note": "默认保留数据目录（设备身份与同步索引在里面）；删掉它等于重置本机身份。同步目录本身不在那里，不受影响。"
  },
  "update": {
    "kind": "brew"
  },
  "requires": {
    "local_network": true,
    "system_daemon": true,
    "ports": [
      8384
    ]
  }
}